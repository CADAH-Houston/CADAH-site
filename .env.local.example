# Copy this file to .env.local (locally) or add these in Vercel's
# Project Settings > Environment Variables (for the deployed site).
# Until these are set, the site runs fine in "demo mode" with sample data.

# From Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — SECRET. Server-side only, never exposed to the browser.
# From Supabase Dashboard > Project Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY=

# A shared passcode for the temporary admin photo-upload page
# (/admin/upload). Replace with real admin login in a later build step.
# Make this a long, random string.
ADMIN_UPLOAD_PASSCODE=
